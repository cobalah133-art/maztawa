        // KALKULATOR functions
        var PCT = [100, 95, 90, 80, 70, 60, 50, 40, 30];

        function brzycki(w, r) {
            if (r < 1 || r > 36) return NaN;
            return w * 36 / (37 - r);
        }
        function fmt(x) {
            if (isNaN(x)) return '-';
            return (Math.round(x * 10) / 10).toFixed(1);
        }

        function hitungMax() {
            var name = document.getElementById('selExercise').value;
            var w = parseFloat(document.getElementById('inWeight').value);
            var r = parseInt(document.getElementById('inRep').value);
            var bb = parseFloat(document.getElementById('inBB').value);
            var max = brzycki(w, r);
            var target = bb * 2;
            var ach = max / target * 100;

            var box = document.getElementById('calcResult');
            if (isNaN(max) || max <= 0) {
                box.innerHTML = '<div class="res-item"><div class="val" style="color:#ff4757">ERROR</div><div class="lbl">Rep harus 1&ndash;36</div></div>';
                document.getElementById('calcPctGrid').innerHTML = '';
                return;
            }
            window.currentMax = max;
            box.innerHTML =
                '<div class="res-item"><div class="val">' + fmt(w) + '</div><div class="lbl">Weight (kg)</div></div>' +
                '<div class="res-item"><div class="val">' + r + '</div><div class="lbl">Repetition</div></div>' +
                '<div class="res-item"><div class="val">' + fmt(max) + '</div><div class="lbl">100% Max (kg)</div></div>' +
                '<div class="res-item"><div class="val">' + fmt(target) + '</div><div class="lbl">Target (2&times;BB)</div></div>' +
                '<div class="res-item"><div class="val">' + fmt(ach) + '%</div><div class="lbl">Achievement</div></div>';

            document.getElementById('calcPctGrid').innerHTML = PCT.map(function (p) {
                return '<div class="calc-pct-item"><div class="p">' + p + '% Max</div><div class="v">' + fmt(max * p / 100) + ' kg</div></div>';
            }).join('');

            var steps = document.getElementById('calcSteps');
            steps.style.display = 'block';
            steps.innerHTML =
                '<span class="hl">Langkah perhitungan ' + name + ':</span><br>' +
                '100% Max = ' + w + ' &times; 36 &divide; (37 &minus; ' + r + ')<br>' +
                '100% Max = ' + w + ' &times; 36 &divide; ' + (37 - r) + '<br>' +
                '100% Max = <span class="hl">' + fmt(max) + ' kg</span><br><br>' +
                'Achievement = ' + fmt(max) + ' &divide; ' + fmt(target) + ' &times; 100 = <span class="hl">' + fmt(ach) + '%</span>';
        }

        function resetCalc() {
            window.currentMax = NaN;
            document.getElementById('inWeight').value = '';
            document.getElementById('inRep').value = '';
            document.getElementById('inBB').value = '';
            document.getElementById('selExercise').selectedIndex = 0;
            document.getElementById('calcResult').innerHTML = '';
            document.getElementById('calcPctGrid').innerHTML = '';
            document.getElementById('calcSteps').style.display = 'none';
        }

        function convertLbsToKg() {
            var lbs = document.getElementById('lbsInput').value;
            if (lbs !== '') {
                var kg = parseFloat(lbs) / 2.20462;
                document.getElementById('kgInput').value = fmt(kg);
            }
        }
        function convertKgToLbs() {
            var kg = document.getElementById('kgInput').value;
            if (kg !== '') {
                var lbs = parseFloat(kg) * 2.20462;
                document.getElementById('lbsInput').value = fmt(lbs);
            }
        }

        /* ===== TACTICAL ENHANCEMENTS (data-driven, tidak mengubah angka) ===== */
        function tagSegmented(root){
          (root||document).querySelectorAll('.progress-item').forEach(function(it){
            var v = it.querySelector('.progress-value');
            var pct = v ? parseFloat(v.textContent) : NaN;
            it.classList.remove('low','mid','high');
            if (!isNaN(pct)) {
              it.classList.add(pct < 45 ? 'low' : pct < 70 ? 'mid' : 'high');
              if (v) v.classList.toggle('hot', pct < 45);
            }
          });
        }
        function drawSpark(canvas, vals, color){
          var dpr = window.devicePixelRatio || 1;
          var w = canvas.clientWidth || 360, h = canvas.clientHeight || 56;
          canvas.width = w * dpr; canvas.height = h * dpr;
          var ctx = canvas.getContext('2d'); ctx.scale(dpr, dpr);
          ctx.clearRect(0,0,w,h);
          var min = Math.min.apply(null, vals.concat([0])), max = Math.max.apply(null, vals.concat([100]));
          var px = function(i){ return 6 + i * (w-12) / Math.max(1, vals.length-1); };
          var py = function(v){ return h-8 - (v-min)/(Math.max(1,max-min)) * (h-18); };
          // area
          ctx.beginPath(); ctx.moveTo(px(0), py(vals[0]));
          vals.forEach(function(v,i){ ctx.lineTo(px(i), py(v)); });
          ctx.lineTo(px(vals.length-1), h); ctx.lineTo(px(0), h); ctx.closePath();
          ctx.fillStyle = 'rgba(230,51,41,.14)'; ctx.fill();
          // garis
          ctx.beginPath(); ctx.moveTo(px(0), py(vals[0]));
          vals.forEach(function(v,i){ ctx.lineTo(px(i), py(v)); });
          ctx.strokeStyle = color || '#e63329'; ctx.lineWidth = 2; ctx.lineJoin='round'; ctx.stroke();
          // titik
          vals.forEach(function(v,i){
            ctx.beginPath(); ctx.arc(px(i), py(v), 2.6, 0, 7); ctx.fillStyle = '#fff'; ctx.fill();
            ctx.beginPath(); ctx.arc(px(i), py(v), 1.4, 0, 7); ctx.fillStyle = color || '#e63329'; ctx.fill();
          });
          // garis ideal 75
          ctx.setLineDash([4,4]); ctx.strokeStyle='rgba(255,255,255,.25)'; ctx.lineWidth=1;
          ctx.beginPath(); ctx.moveTo(0,py(75)); ctx.lineTo(w,py(75)); ctx.stroke(); ctx.setLineDash([]);
        }
        function buildSparklines(){
          document.querySelectorAll('.tab-content').forEach(function(sec){
            if (sec.querySelector('.spark-wrap')) return;
            var vals = Array.prototype.map.call(
              sec.querySelectorAll('.progress-value'),
              function(el){ return parseFloat(el.textContent); }
            ).filter(function(x){ return !isNaN(x); });
            if (vals.length < 3) {
              // fallback OVERALL: baca kolom Avg tabel perbandingan
              var avgs = Array.prototype.map.call(
                sec.querySelectorAll('.comparison-table tbody tr td:last-child'),
                function(td){ return parseFloat(td.textContent); }
              ).filter(function(x){ return !isNaN(x); });
              if (avgs.length >= 3) vals = avgs;
            }
            if (vals.length < 3) return;
            var cards = sec.querySelectorAll('.stat-card');
            var host = cards.length ? cards[cards.length-1] : null;
            if (!host) return;
            var wrap = document.createElement('div'); wrap.className = 'spark-wrap';
            var cv = document.createElement('canvas'); cv.className = 'spark';
            wrap.appendChild(cv); host.appendChild(wrap);
            var cap = document.createElement('div'); cap.className = 'spark-cap';
            var mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals);
            cap.innerHTML = '<span>MIN <b>'+mn+'%</b></span><span>IDEAL 75%</span><span>MAX <b>'+mx+'%</b></span>';
            host.appendChild(cap);
            requestAnimationFrame(function(){ drawSpark(cv, vals); });
          });
          window.addEventListener('resize', function(){
            document.querySelectorAll('.tab-content').forEach(function(sec){
              var cv = sec.querySelector('.spark-wrap canvas');
              if (!cv || !sec.classList.contains('active')) return;
              var vals = Array.prototype.map.call(sec.querySelectorAll('.progress-value'), function(el){ return parseFloat(el.textContent); }).filter(function(x){ return !isNaN(x); });
              if (vals.length >= 3) drawSpark(cv, vals);
            });
          });
        }
        function buildGauges(){
          document.querySelectorAll('.average-box').forEach(function(box){
            if (box.querySelector('.gauge')) return;
            var el = box.querySelector('.avg-value');
            if (!el) return;
            var pct = parseFloat(el.textContent) || 0;
            var C = 2 * Math.PI * 46;
            var svgNS = 'http://www.w3.org/2000/svg';
            var svg = document.createElementNS(svgNS, 'svg');
            svg.setAttribute('viewBox','0 0 120 120'); svg.setAttribute('class','gauge');
            var trk = document.createElementNS(svgNS,'circle');
            trk.setAttribute('cx','60'); trk.setAttribute('cy','60'); trk.setAttribute('r','46'); trk.setAttribute('class','trk');
            var arc = document.createElementNS(svgNS,'circle');
            arc.setAttribute('cx','60'); arc.setAttribute('cy','60'); arc.setAttribute('r','46'); arc.setAttribute('class','arc');
            arc.setAttribute('stroke-dasharray', String(C));
            arc.setAttribute('stroke-dashoffset', String(C));
            svg.appendChild(trk); svg.appendChild(arc);
            box.insertBefore(svg, box.firstChild);
            requestAnimationFrame(function(){ requestAnimationFrame(function(){
              arc.style.strokeDashoffset = String(C * (1 - Math.min(100,pct)/100));
            }); });
          });
        }
        function tactHeader(){
          var h = document.querySelector('.main-header'); if (!h || h.querySelector('.eyebrow')) return;
          var sub = h.querySelector('.subtitle');
          var eb = document.createElement('div'); eb.className = 'eyebrow'; eb.textContent = 'Dojang Analytics — Agustus 2026';
          h.insertBefore(eb, h.firstChild);
          var h1 = h.querySelector('h1');
          if (h1 && !h1.querySelector('.red')) {
            var words = h1.textContent.trim().split(/\s+/);
            h1.innerHTML = words.map(function(w,i){ return i === words.length-1 ? '<span class="red">'+w+'</span>' : w; }).join(' ');
          }
          if (sub && sub.textContent.indexOf('●') === -1) { sub.innerHTML = '<i></i>' + sub.innerHTML; }
          var meta = document.createElement('div'); meta.className = 'hdr-meta';
          meta.innerHTML = '<span>ATLET <b>10</b></span><span>ITEM TES <b>5</b></span><span>METODE <b>BRZYCKI</b></span><span>MODE <b>OLED</b></span>';
          h.appendChild(meta);
        }

        function swapConversion() {
            var lbsVal = document.getElementById('lbsInput').value;
            var kgVal = document.getElementById('kgInput').value;
            if (lbsVal !== '') {
                document.getElementById('kgInput').value = lbsVal;
                document.getElementById('lbsInput').value = '';
                convertKgToLbs();
            } else if (kgVal !== '') {
                document.getElementById('lbsInput').value = kgVal;
                document.getElementById('kgInput').value = '';
                convertLbsToKg();
            }
        }

